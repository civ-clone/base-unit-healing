{
  "name": "@civ-clone/base-unit-healing",
  "version": "0.0.0",
  "description": "Healing for damaged units: units that rest heal at the start of their player's turn, with bonuses near and in their own cities and full healing where the game says, and damaged units move more slowly.",
  "repository": "git@github.com:civ-clone/base-unit-healing.git",
  "keywords": [
    "typescript",
    "civilization"
  ],
  "author": "dom111 <dom111@users.noreply.github.com>",
  "license": "MIT",
  "private": false,
  "scripts": {
    "build": "npm run ts:compile && npm run prettier:format",
    "prettier:check": "prettier --config .prettierrc --check '**/*.ts'",
    "prettier:format": "prettier --config .prettierrc '**/*.ts' --write",
    "test": "ts-mocha ./tests/*.test.ts",
    "ts:compile": "tsc --build tsconfig.json"
  },
  "devDependencies": {
    "@civ-clone/core-terrain": "^0.1.0",
    "@civ-clone/core-world-generator": "^0.1.0",
    "@types/chai": "^4.0.0",
    "@types/mocha": "^10.0.0",
    "@types/node": "^16.0.0",
    "chai": "^4.0.0",
    "mocha": "^10.0.0",
    "prettier": "^2.8.8",
    "ts-mocha": "^10.0.0",
    "typescript": "^4.0.0"
  },
  "dependencies": {
    "@civ-clone/core-city": "^0.1.19",
    "@civ-clone/core-player": "^0.1.10",
    "@civ-clone/core-rule": "^0.1.9",
    "@civ-clone/core-unit": "^0.1.32",
    "@civ-clone/core-unit-improvement": "^0.1.0",
    "@civ-clone/core-world": "^0.1.24",
    "@civ-clone/core-yield": "^0.1.0"
  }
}
